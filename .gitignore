# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next
/out
next-env.d.ts

# Production
/build

# Environment & secrets, NEVER commit these
.env
.env.local
.env*.local

# Database (user data)
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/*.sqlite

# Runtime model config, written by the app
/data/llama-runtime.env

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
*.pem
.vscode/
.idea/

# Local agent / scratch files
/.claude
*.nmap
*.gnmap
*.xml.scan
/full_lab_report.*

# Build cache
*.tsbuildinfo
