# ==============================================================
#  Copy this to .env.local:   cp .env.example .env.local
#  Only AUTH_SECRET is required to boot. Everything else is optional
#  or has a sane default. setup.sh fills in AUTH_SECRET for you.
# ==============================================================

# ---- Branding (optional) -------------------------------------
# Rename the whole app without touching code. NEXT_PUBLIC_* values
# also show up in the browser UI.
NEXT_PUBLIC_APP_NAME="Chakor"
NEXT_PUBLIC_APP_TAGLINE="Your AI, on your hardware. No cloud, no tracking, no big tech."
APP_DESCRIPTION="An open source AI workspace you run yourself."
APP_CREATOR=""

# ---- Auth (required) -----------------------------------------
# Generate the secret with:  openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_WITH_openssl_rand_base64_32"
AUTH_URL="http://localhost:3001"

# Who can make accounts: open, invite, or closed.
REGISTRATION_MODE="invite"
INVITE_CODE="change-me"

# ---- Local models --------------------------------------------
# Option 1: Ollama (easiest, works on every OS). Install it, run
# `ollama pull llama3.2`, and the model shows up automatically.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Option 2: llama.cpp. Chakor runs llama-server for you as part of the same
# service. Point it at your binary and a default .gguf; after that you switch the
# model and context size live from Settings -> Models, no restart, no terminal.
LLAMA_BASE_URL="http://127.0.0.1:4546"
LLAMA_MODEL="Chakor"
LLAMA_CONTEXT="8192"
# Path to the llama-server binary. Default looks in ~/llama.cpp/build/bin and PATH.
LLAMA_SERVER_BIN=""
# Default model to load on boot. If blank, Chakor picks the largest .gguf it finds.
LLAMA_GGUF=""
# Extra folders to scan for .gguf files (colon separated). ~/Downloads, ~/models,
# and ~/.lmstudio are always included.
CHAKOR_MODELS_DIR=""
# Set to "false" if you run llama-server yourself or use Ollama/cloud only.
CHAKOR_SUPERVISE_LLAMA="true"

# ---- Cloud models (optional, bring your own key) -------------
# Each key you add turns on that provider's models in the picker.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# OpenRouter: one key, hundreds of models. Pick which ones show up
# as "id|Label" pairs, comma separated.
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="meta-llama/llama-3.3-70b-instruct|Llama 3.3 70B, deepseek/deepseek-chat|DeepSeek V3, anthropic/claude-3.5-sonnet|Claude 3.5 Sonnet"

# ---- Web search (optional) -----------------------------------
# SearXNG first, then Brave if a key is set, then DuckDuckGo.
SEARXNG_URL="http://127.0.0.1:8080"
BRAVE_SEARCH_API_KEY=""

# ---- Database ------------------------------------------------
CHAKOR_DB_PATH="./data/chakor.db"
