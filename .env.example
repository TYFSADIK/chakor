# ==============================================================
#  Copy this to .env.local:   cp .env.example .env.local
#  Only AUTH_SECRET is required to boot. Everything else is optional
#  or has a sane default. setup.sh fills in AUTH_SECRET for you.
# ==============================================================

# ---- Branding (optional) -------------------------------------
# Rename the whole app without touching code. NEXT_PUBLIC_* values
# also show up in the browser UI.
NEXT_PUBLIC_APP_NAME="Chakor"
NEXT_PUBLIC_APP_TAGLINE="Your AI, on your hardware. No cloud, no tracking, no big tech."
APP_DESCRIPTION="An open source AI workspace you run yourself."
APP_CREATOR=""

# ---- Auth (required) -----------------------------------------
# Generate the secret with:  openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_WITH_openssl_rand_base64_32"
AUTH_URL="http://localhost:3001"

# Who can make accounts: open, invite, or closed.
REGISTRATION_MODE="invite"
INVITE_CODE="change-me"

# ---- Local models --------------------------------------------
# Chakor auto-detects whichever of these is running and shows it in the model
# menu. Settings -> Models tells you what your machine can actually run, so you
# don't load something too big and crash it.
#
# Option 1: Ollama (easiest, works on every OS). Install it, run
# `ollama pull llama3.2`, and the model shows up automatically.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Option 2: LM Studio. Turn on its local server (Developer tab -> Start Server)
# and whatever models you have loaded there appear automatically. The default
# port is 1234; the OpenAI-compatible path ends in /v1.
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# Option 3: llama.cpp. Chakor runs llama-server for you as part of the same
# service. Point it at your binary and a default .gguf; after that you switch the
# model and context size live from Settings -> Models, no restart, no terminal.
LLAMA_BASE_URL="http://127.0.0.1:4546"
# Interface llama-server binds to. The default CHANGED to 127.0.0.1 for
# security: llama-server has no auth of its own, so it stays loopback-only.
# Only set 0.0.0.0 if you deliberately want to expose the raw model to your LAN.
LLAMA_HOST="127.0.0.1"
LLAMA_MODEL="Chakor"
LLAMA_CONTEXT="8192"
# Set to "true" if your build of llama-server supports vision (mmproj) and you
# want the image attach button shown for local models.
LLAMA_VISION=""
# GPU layers to offload. Default 9999 = ALL layers on the GPU (Chakor never
# falls back to CPU compute). Only lower this if a model truly cannot fit.
# Serving memory knobs: one sequence slot and a small batch window keep the
# VRAM compute buffer small so full offload still leaves headroom for long
# replies on small cards. LLAMA_THREADS = CPU threads (used for prompt
# processing of any RAM-resident parts), LLAMA_NPREDICT = max tokens per reply.
LLAMA_NGL="9999"
LLAMA_PARALLEL="1"
LLAMA_BATCH="512"
LLAMA_UBATCH="128"
LLAMA_THREADS="8"
LLAMA_NPREDICT="4096"
# Extra raw llama-server flags, space separated, e.g. "--flash-attn --mlock".
LLAMA_EXTRA=""
# Path to the llama-server binary. Default looks in ~/llama.cpp/build/bin and PATH.
LLAMA_SERVER_BIN=""
# Default model to load on boot. If blank, Chakor picks the largest .gguf it finds.
LLAMA_GGUF=""
# Extra folders to scan for .gguf files (colon separated). ~/Downloads, ~/models,
# and ~/.lmstudio are always included.
CHAKOR_MODELS_DIR=""
# Set to "false" if you run llama-server yourself or use Ollama/cloud only.
CHAKOR_SUPERVISE_LLAMA="true"
# If a model is too big it makes llama-server crash on launch. After this many
# back-to-back fast crashes Chakor stops retrying and tells you to pick a smaller
# model (instead of looping forever). Raise it if you have a flaky cold start.
CHAKOR_LLAMA_MAX_CRASHES="4"

# Download GGUF models from Hugging Face right inside the app (Settings -> Models
# -> Download from Hugging Face). Public models need no token. Set one to lift
# rate limits or reach gated repos. Get it at huggingface.co/settings/tokens.
HF_TOKEN=""

# ---- Image generation (optional) -----------------------------
# Chakor generates images through stable-diffusion.cpp's sd-server, which it
# spawns on demand (no separate service to run). Off by default — an admin
# enables it per user under Admin -> Image Generation. Works on any GPU; on
# small cards it runs in "swap" mode: the chat model is paused while an
# image renders (which can take minutes), then brought back. With 12+ GB
# VRAM (or 32+ GB unified memory) both stay resident ("parallel"). Each
# user can generate 10 images per day.
# The default model is an Iris-architecture GGUF (Sakura-Iris-3B) with a
# Qwen3-VL text encoder — ComfyUI cannot run this architecture, which is
# why Chakor talks to sd-server directly.
SDCPP_URL="http://127.0.0.1:8190"
# The stable-diffusion.cpp checkout. The server binary is expected at
# <SDCPP_DIR>/build/bin/sd-server; model .gguf files live in <SDCPP_DIR>/models.
SDCPP_DIR=""
# Text encoder for the image pipeline. Blank = auto-discover from
# <SDCPP_DIR>/models (prefers a Sakura/Qwen3VL encoder GGUF found there).
SDCPP_ENCODER=""
# auto | swap | parallel — force the GPU handoff strategy (default: auto).
IMAGE_ENGINE_MODE="auto"
# Image size/steps defaults. The admin panel's quality preset (fast /
# balanced / quality) takes precedence over these when set. Iris is trained
# at 1024x1024 and is clean at 30 steps; smaller sizes or fewer steps are
# faster but show visible artifacts. On a 4 GB card in swap mode a
# full-quality image takes roughly half an hour.
IMAGE_DEFAULT_SIZE="1024x1024"
IMAGE_DEFAULT_STEPS="30"
# Images per user per day (default 10). Admins are never limited — they run
# the hardware. Each render monopolizes the GPU, so keep a limit on public sites.
IMAGE_DAILY_LIMIT="10"
# Hard cap on one image job, in minutes (default 45). A 1024px/30-step render
# takes ~30 min on a 4 GB GPU; big cards finish in well under a minute. A
# separate 5-minute no-progress watchdog fails wedged jobs much sooner.
IMAGE_JOB_TIMEOUT_MINUTES="45"

# ---- Cloud models (optional, bring your own key) -------------
# Each key you add turns on that provider's models in the picker.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# OpenRouter: one key, hundreds of models. Pick which ones show up
# as "id|Label" pairs, comma separated.
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="meta-llama/llama-3.3-70b-instruct|Llama 3.3 70B, deepseek/deepseek-chat|DeepSeek V3, anthropic/claude-3.5-sonnet|Claude 3.5 Sonnet"

# ---- Web search (optional) -----------------------------------
# SearXNG first, then Brave if a key is set, then DuckDuckGo.
SEARXNG_URL="http://127.0.0.1:8080"
BRAVE_SEARCH_API_KEY=""

# ---- Agent Workspace (optional) ------------------------------
# The agent runs Python (docx/pptx/charts) through scripts/sandbox-runner.py.
# setup.sh / install.sh create a .venv with the needed packages and fill this
# in for you. Blank = auto-detect ./.venv, then fall back to system python3.
CHAKOR_PYTHON=""
# Root folder every conversation workspace must live under. Blank = ./data/workspaces.
# The sandbox runner re-checks containment against this path.
CHAKOR_WORKSPACE=""

# ---- Security: tool network access ---------------------------
# DANGEROUS: by default Chakor's server-side fetch tools (web search, URL
# reads) refuse private/loopback/link-local addresses so agent or web content
# cannot reach your LAN, cloud metadata endpoints, etc. Setting this to "true"
# disables that protection entirely — only do it on a fully trusted, isolated
# network where the tools legitimately need to reach internal hosts.
TOOLS_ALLOW_PRIVATE=""

# ---- Database ------------------------------------------------
CHAKOR_DB_PATH="./data/chakor.db"

# ---- Reverse proxy -------------------------------------------
# Set to "true" ONLY when Chakor sits behind a reverse proxy (nginx, Caddy,
# cloudflared, ...) that sets a trusted x-forwarded-for header. Login and
# registration rate limits are then applied per real client IP. Leave unset
# when clients connect directly — otherwise anyone can spoof the header to
# dodge the rate limits.
TRUST_PROXY=""

# ---- Advanced ------------------------------------------------
# Build into a different .next directory, for staging builds that sit next to
# a running production build without clobbering it. Build-time only, e.g.:
#   CHAKOR_DIST_DIR=.next-staging npm run build
CHAKOR_DIST_DIR=""
